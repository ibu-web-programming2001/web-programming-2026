# Secrets – only config.example.php is committed
backend/config/config.php

# Composer dependencies (run `composer install` to get them)
backend/vendor/

# Log files
backend/logs/*
!backend/logs/.gitkeep

# OS / editor files
.DS_Store
.idea/
.vscode/

# Cached copies of external data (downloaded again when missing)
backend/cache/*
!backend/cache/.gitkeep
