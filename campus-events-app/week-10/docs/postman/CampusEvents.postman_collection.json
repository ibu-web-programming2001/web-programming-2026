{
  "info": {
    "name": "CampusEvents API",
    "description": "Week 09 – API tests in Postman. Import into Postman (File → Import) or run with newman:\n  npx newman run CampusEvents.postman_collection.json -e CampusEvents.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusevents.ba\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has a token and the user\", () => {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.user.role).to.eql(\"admin\");",
                  "});",
                  "pm.test(\"Password hash is never returned\", () => pm.expect(json.user).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"admin_token\", json.token);   // used by the next requests"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lana@campusevents.ba\",\n  \"password\": \"Student123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"student_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusevents.ba\",\n  \"password\": \"wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.eql(\"Invalid email or password.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Events",
      "item": [
        {
          "name": "All events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "const events = pm.response.json();",
                  "pm.test(\"Response is an array with at least 12 events\", () => {",
                  "    pm.expect(events).to.be.an(\"array\");",
                  "    pm.expect(events.length).to.be.at.least(12);",
                  "});",
                  "pm.test(\"Every event has the required properties\", () => {",
                  "    events.forEach(e => pm.expect(e).to.include.all.keys(\"id\", \"title\", \"club_name\", \"category_name\", \"starts_at\", \"available_seats\"));",
                  "});",
                  "pm.test(\"Response time is below 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "One event",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/9",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "9"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const event = pm.response.json();",
                  "pm.test(\"Specific values\", () => {",
                  "    pm.expect(event.title).to.eql(\"Open Mic Night\");",
                  "    pm.expect(event.club_name).to.eql(\"IBU Music Club\");",
                  "    // MySQL DECIMAL (ROUND/AVG) arrives as a STRING in JSON (\"4.5\") – compare as a number",
                  "    pm.expect(Number(event.average_rating)).to.eql(4.5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing event -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.eql(\"Event not found.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student cannot create -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Not allowed\",\n  \"club_id\": 1,\n  \"category_id\": 1,\n  \"location\": \"Hall\",\n  \"starts_at\": \"2030-01-01 10:00\",\n  \"capacity\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid event -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"club_id\": 1,\n  \"category_id\": 1,\n  \"location\": \"Hall\",\n  \"starts_at\": \"2030-01-01 10:00\",\n  \"capacity\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Message mentions the field\", () => pm.expect(pm.response.json().error).to.include(\"title\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create event -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Workshop\",\n  \"club_id\": 2,\n  \"category_id\": 2,\n  \"location\": \"FENS Lab 1\",\n  \"starts_at\": \"2030-03-01 17:00\",\n  \"capacity\": 25\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const event = pm.response.json();",
                  "pm.test(\"All seats are free\", () => pm.expect(event.available_seats).to.eql(25));",
                  "pm.collectionVariables.set(\"event_id\", event.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{event_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{event_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Workshop (bigger room)\",\n  \"club_id\": 2,\n  \"category_id\": 2,\n  \"location\": \"FENS Lab 2\",\n  \"starts_at\": \"2030-03-01 17:00\",\n  \"capacity\": 40\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title changed\", () => pm.expect(pm.response.json().title).to.eql(\"Postman Test Workshop (bigger room)\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{event_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{event_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Message\", () => pm.expect(pm.response.json().message).to.eql(\"Event deleted.\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Registrations & dashboard",
      "item": [
        {
          "name": "Student sees only own registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Every registration belongs to Lana (id 4)\", () => {",
                  "    pm.response.json().forEach(r => pm.expect(r.user_id).to.eql(4));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const stats = pm.response.json();",
                  "pm.test(\"Admin statistics\", () => {",
                  "    pm.expect(stats.role).to.eql(\"admin\");",
                  "    pm.expect(stats.registrations_per_category).to.be.an(\"array\").that.has.lengthOf(5);",
                  "});",
                  "pm.test(\"Registrations per category add up\", () => {",
                  "    const total = stats.registrations_per_category.reduce((sum, row) => sum + row.total, 0);",
                  "    pm.expect(total).to.be.at.least(stats.upcoming_registrations);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    },
    {
      "key": "event_id",
      "value": ""
    }
  ]
}